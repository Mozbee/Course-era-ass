{
  "name": "bagswap-film",
  "version": "1.0.0",
  "private": true,
  "description": "BagSwap — The Next Handoff. 30-second product film (Remotion).",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.js",
    "audio": "node scripts/make-audio.mjs",
    "render:landscape": "remotion render src/index.js BagSwapLandscape out/BagSwap-Intro-Landscape.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k --browser-executable=$BROWSER_EXECUTABLE",
    "render:vertical": "remotion render src/index.js BagSwapVertical out/BagSwap-Intro-Vertical.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k --browser-executable=$BROWSER_EXECUTABLE",
    "render": "npm run render:landscape && npm run render:vertical && bash scripts/finalize.sh",
    "stills": "node scripts/stills.mjs out/stills"
  },
  "dependencies": {
    "@fontsource/manrope": "5.2.6",
    "@remotion/cli": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
